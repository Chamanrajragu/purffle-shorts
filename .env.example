# ─────────────────────────────────────────────────────────────────────────────
# PurffleShorts 3 — copy to .env and fill in what you use. Everything is optional
# except ONE LLM key (or a local Ollama) and, for uploading, credentials.json.
# Run `python -m purffle_shorts doctor` to check your setup.
# Keep comments on their own lines: Docker's --env-file would read a comment after a value as part of it.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI script writer (pick any; LLM_PROVIDER=auto uses the first key found) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# XAI_API_KEY=
# auto|openai|anthropic|gemini|groq|openrouter|deepseek|mistral|together|xai|ollama|lmstudio|custom
LLM_PROVIDER=auto
# blank = provider default (see `providers` command); for Ollama, blank also falls back to a model you have pulled
LLM_MODEL=
# e.g. anthropic,gemini — tried in order if the main LLM fails
LLM_FALLBACKS=
# for LLM_PROVIDER=custom (any OpenAI-compatible endpoint)
# LLM_BASE_URL=
# LLM_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# low|medium|high|xhigh|max (Claude only)
# ANTHROPIC_EFFORT=
# Script Doctor: a second LLM pass per video. rewrite = score + use the improved script, score = only score, off
SCRIPT_REVIEW=rewrite

# ── Stock footage ──
PEXELS_API_KEY=
PIXABAY_API_KEY=
# also: local (MEDIA_DIR), openai-images, pollinations (AI images)
VISUAL_SOURCES=pexels,pixabay
# Pollinations without a key is limited to about one image every few minutes (HTTP 402 otherwise)
# POLLINATIONS_API_KEY=
# your own clips/photos; filenames are matched to scene keywords
MEDIA_DIR=media
# for openai-images (or dall-e-3)
IMAGE_MODEL=gpt-image-1
PREFER_4K=false

# ── Content ──
NICHES=mind-blowing science facts,unsolved mysteries,dark history,space and the universe,psychology tricks
# niche,trending,wikipedia,reddit,rss,file — weights allowed: niche:4,trending:1
TOPIC_SOURCES=niche
                                # (ideas queued with `plan` / `ideas --add` are always used first)
TOPICS_FILE=topics.txt
# for TOPIC_SOURCES=rss
# RSS_FEEDS=https://example.com/feed.xml,https://another.site/rss
TRENDS_GEO=US
# auto|facts|story|listicle|myth|quiz|motivational|news|explainer|dialogue|chat|reddit
SCRIPT_STYLE=auto
# en, es, fr, de, hi, ta, te, pt, ja, ko, zh, ar, ... (voice picked automatically)
LANGUAGE=en
# also publish every video in these languages (translated, same footage)
ALSO_LANGUAGES=
TARGET_SECONDS=40
CHANNEL_NAME=PurffleStudios
AUDIENCE=curious general audience

# ── Voice ──
# edge (free) | openai | elevenlabs | kokoro | coqui | system | silent
TTS_ENGINE=edge
# blank = best voice for LANGUAGE; comma list = rotate. `voices --lang xx` lists a language's voices
TTS_VOICE=
# second speaker for the dialogue and chat formats (blank = a contrasting voice for LANGUAGE)
TTS_VOICE_B=
TTS_RATE=+8%
# openai: gpt-4o-mini-tts | tts-1-hd ; elevenlabs: eleven_multilingual_v2 ...
TTS_MODEL=
ELEVENLABS_API_KEY=
# word timing for voices without it: auto|faster-whisper|openai|none
ALIGN=auto

# ── Look ──
# 9:16 (Shorts/Reels/TikTok) | 16:9 (regular video) | 1:1 | 4:5 — RESOLUTION overrides
ASPECT=9:16
# RESOLUTION=1080x1920
FPS=30
# bold|boxed|neon|clean|karaoke|minimal
CAPTION_STYLE=bold
# upper|center|lower
CAPTION_POSITION=center
CAPTION_MAX_WORDS=3
CAPTION_UPPERCASE=true
# path to a .ttf to override the font
CAPTION_FONT=
# none|vivid|cinematic|warm|cool|bw
COLOR_GRADE=vivid
# random|none|fade|slideup|smoothleft|circleopen|zoomin|...
TRANSITION=random
KEN_BURNS=true
PROGRESS_BAR=true
HOOK_OVERLAY=true
# blank = CHANNEL_NAME, "none" to hide
WATERMARK=
END_CTA=Follow for more!
# random track per video; falls back to MUSIC_FILE
MUSIC_DIR=music
MUSIC_FILE=back.mp3
MUSIC_VOLUME=0.14
MUSIC_DUCKING=true
# libx264|h264_videotoolbox (Mac)|h264_nvenc (NVIDIA)|auto
VIDEO_ENCODER=libx264
CRF=21
PRESET=veryfast

# ── YouTube ──
UPLOAD=true
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
# where the sign-in token is saved; give each channel its own file when you run several
# YT_TOKEN_FILE=token.json
# public|unlisted|private
YT_PRIVACY=public
# e.g. 09:00,14:00,19:00 -> uploads are scheduled into these slots
PUBLISH_TIMES=
# e.g. Asia/Kolkata (blank = this computer's timezone)
TIMEZONE=
# uploads per day: a pace, not the API ceiling (uploads have their own 100/day bucket)
YT_DAILY_LIMIT=6
PLAYLIST_ID=
MADE_FOR_KIDS=false
# YouTube's altered/synthetic content disclosure
SYNTHETIC_MEDIA=true
# keep the MP4 after a successful upload
KEEP_VIDEOS=false
CREDIT_FOOTAGE=true
# Show the LLM which of your uploads got the most / fewest views (refreshed twice a day on autopilot)
LEARN_FROM_STATS=false
# optional: reads public view counts without extra OAuth access (otherwise run `auth` once more)
# YOUTUBE_API_KEY=

# ── Notifications ──
# Discord or Slack webhook, or any URL (receives JSON): rendered / uploaded / scheduled / queued / failed
# NOTIFY_WEBHOOK=

# ── Autopilot ──
BATCH_SIZE=1
# seconds between batches
BATCH_DELAY=60
# videos rendered in parallel
WORKERS=1
OUTPUT_DIR=output_videos
DATA_DIR=data

# ── Advanced ──
# auto | pillow | ass  (ass = libass captions; auto uses it for Hindi, Tamil, Arabic, Thai, ...)
# CAPTION_RENDERER=auto
# Path to a specific ffmpeg binary
# FFMPEG_BINARY=
# Set to 1 to keep each video's work/ folder (voice, segments, caption frames) for debugging
# KEEP_WORK=
# PURFFLE_HOME is not read from this file. Set it in your MCP client's "env" block (or the shell) to the
# folder that holds this .env, credentials.json and your videos when an app starts `purffle-shorts mcp`.
