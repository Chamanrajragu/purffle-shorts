# ─────────────────────────────────────────────────────────────────────────────
# PurffleShorts 3 — copy to .env and fill in what you use. Everything is optional
# except ONE LLM key (or a local Ollama) and, for uploading, credentials.json.
# Run `python -m purffle_shorts doctor` to check your setup.
# Keep comments on their own lines: Docker's --env-file would read a comment after a value as part of it.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI script writer (pick any; LLM_PROVIDER=auto uses the first key found) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# XAI_API_KEY=
# auto|openai|anthropic|gemini|groq|openrouter|deepseek|mistral|together|xai|ollama|lmstudio|custom
LLM_PROVIDER=auto
# blank = provider default (see `providers` command); for Ollama, blank also falls back to a model you have pulled
LLM_MODEL=
# e.g. anthropic,gemini — tried in order if the main LLM fails
LLM_FALLBACKS=
# for LLM_PROVIDER=custom (any OpenAI-compatible endpoint)
# LLM_BASE_URL=
# LLM_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# low|medium|high|xhigh|max (Claude only; blank = high on claude-opus-5-5, the API default elsewhere)
# ANTHROPIC_EFFORT=
# Script Doctor: a second LLM pass per video. rewrite = grade, rewrite, re-grade and keep the better script;
# score = only grade it; off
SCRIPT_REVIEW=rewrite
# more rewrite rounds while the score is below SCRIPT_TARGET_SCORE (each round is two more LLM calls)
# SCRIPT_REVIEW_ROUNDS=1
# SCRIPT_TARGET_SCORE=80
# turn off strict JSON-schema replies for OpenAI-compatible providers (on by default where supported)
# LLM_JSON_SCHEMA=true

# ── Stock footage ──
PEXELS_API_KEY=
PIXABAY_API_KEY=
# also: local (MEDIA_DIR), openai-images, pollinations (AI images)
VISUAL_SOURCES=pexels,pixabay
# Pollinations without a key is limited to about one image every few minutes (HTTP 402 otherwise)
# POLLINATIONS_API_KEY=
# your own clips/photos; filenames are matched to scene keywords
MEDIA_DIR=media
# for openai-images (or dall-e-3)
IMAGE_MODEL=gpt-image-1
PREFER_4K=false
# a video (or a folder of videos: one is picked at random) played under the whole story, e.g. gameplay.
# Only use videos you have the rights to.
# BACKGROUND_VIDEO=media/backgrounds
# full = the background video is the picture; split = footage in the top half, the background below
# BACKGROUND_LAYOUT=full

# ── Content ──
NICHES=mind-blowing science facts,unsolved mysteries,dark history,space and the universe,psychology tricks
# niche,search,trending,wikipedia,reddit,rss,file — weights allowed: niche:4,search:2,trending:1
# (search = questions people type into YouTube's search box about your niches)
TOPIC_SOURCES=niche
                                # (ideas queued with `plan` / `ideas --add` are always used first)
TOPICS_FILE=topics.txt
# for TOPIC_SOURCES=rss
# RSS_FEEDS=https://example.com/feed.xml,https://another.site/rss
TRENDS_GEO=US
# auto|facts|story|listicle|myth|quiz|motivational|news|explainer|dialogue|chat|reddit
SCRIPT_STYLE=auto
# en, es, fr, de, hi, ta, te, pt, ja, ko, zh, ar, ... (voice picked automatically)
LANGUAGE=en
# also publish every video in these languages (translated, same footage)
ALSO_LANGUAGES=
TARGET_SECONDS=40
CHANNEL_NAME=PurffleStudios
AUDIENCE=curious general audience
# hand the script writer real YouTube searches about the topic, for titles, descriptions and tags
SEO_KEYWORDS=true

# ── Voice ──
# edge (free) | openai | elevenlabs | kokoro | coqui | system | silent
TTS_ENGINE=edge
# blank = best voice for LANGUAGE; comma list = rotate. `voices --lang xx` lists a language's voices
TTS_VOICE=
# second speaker for the dialogue and chat formats (blank = a contrasting voice for LANGUAGE)
TTS_VOICE_B=
TTS_RATE=+8%
# openai: gpt-4o-mini-tts | tts-1-hd ; elevenlabs: eleven_multilingual_v2 ...
TTS_MODEL=
ELEVENLABS_API_KEY=
# word timing for voices without it: auto|faster-whisper|openai|none
# (with none or no aligner installed, phrase ends are pinned to the pauses in the audio)
ALIGN=auto
# faster-whisper model for alignment and `clip`: auto (large-v3-turbo on an NVIDIA GPU, small on CPU),
# tiny, base, small, medium, large-v3, large-v3-turbo
# WHISPER_MODEL=auto
# reuse lines already spoken in the same voice, so an edited script re-renders fast
VOICE_CACHE=true
# rumble cut, de-esser and gentle compression on the voice before mixing
VOICE_ENHANCE=true

# ── Look ──
# 9:16 (Shorts/Reels/TikTok) | 16:9 (regular video) | 1:1 | 4:5 — RESOLUTION overrides
ASPECT=9:16
# RESOLUTION=1080x1920
FPS=30
# bold|boxed|neon|clean|karaoke|minimal
CAPTION_STYLE=bold
# upper|center|lower
CAPTION_POSITION=center
CAPTION_MAX_WORDS=3
CAPTION_UPPERCASE=true
# key words (picked by the AI) and numbers in their own colour
CAPTION_EMPHASIS=true
# one emoji per scene pops up above the captions (Twemoji, credited in the description)
CAPTION_EMOJI=true
# path to a .ttf to override the font
CAPTION_FONT=
# none|vivid|cinematic|warm|cool|bw
COLOR_GRADE=vivid
# random|none|fade|slideup|smoothleft|circleopen|zoomin|... (between scenes; shots inside a scene hard-cut)
TRANSITION=random
# scenes longer than this are cut into several shots with different footage (0 = one shot per scene)
MAX_SHOT_SECONDS=4.5
KEN_BURNS=true
PROGRESS_BAR=true
HOOK_OVERLAY=true
# blank = CHANNEL_NAME, "none" to hide
WATERMARK=
END_CTA=Follow for more!
# random track per video; falls back to MUSIC_FILE
MUSIC_DIR=music
MUSIC_FILE=back.mp3
MUSIC_VOLUME=0.14
MUSIC_DUCKING=true
# whoosh on scene changes, pop per text message, low hit under the hook (made in code, no files)
SOUND_EFFECTS=true
# 1.0 = 11 dB under the voice; 0.5 quieter, 2.0 louder
SFX_VOLUME=1.0
# libx264|h264_videotoolbox (Mac)|h264_nvenc (NVIDIA)|auto
VIDEO_ENCODER=libx264
CRF=21
PRESET=veryfast

# ── Clipping long videos (`clip`) ──
# shorten pauses longer than CLIP_MAX_PAUSE seconds and cut "um" / "uh" (cuts stay in sync)
CLIP_JUMP_CUTS=true
CLIP_MAX_PAUSE=0.6
# punch in and out between sentences
CLIP_ZOOM=true

# ── YouTube ──
UPLOAD=true
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
# where the sign-in token is saved; give each channel its own file when you run several
# YT_TOKEN_FILE=token.json
# public|unlisted|private
YT_PRIVACY=public
# e.g. 09:00,14:00,19:00 -> uploads are scheduled into these slots
PUBLISH_TIMES=
# e.g. Asia/Kolkata (blank = this computer's timezone)
TIMEZONE=
# uploads per day: a pace, not the API ceiling (uploads have their own 100/day bucket)
YT_DAILY_LIMIT=6
PLAYLIST_ID=
MADE_FOR_KIDS=false
# YouTube's altered/synthetic content disclosure
SYNTHETIC_MEDIA=true
# keep the MP4 after a successful upload
KEEP_VIDEOS=false
CREDIT_FOOTAGE=true
# titles and descriptions in these languages too, so viewers whose YouTube is in one of them see them
# in their own language (one extra LLM call per video), e.g. es,pt,hi,fr,de
LOCALIZE_METADATA=
# also upload captions.srt as a caption track (400 API units per video; run `auth` again after turning on)
UPLOAD_CAPTIONS=false
# Show the LLM which of your uploads got the most / fewest views (refreshed twice a day on autopilot)
LEARN_FROM_STATS=false
# optional: reads public view counts without extra OAuth access (otherwise run `auth` once more)
# YOUTUBE_API_KEY=

# ── TikTok, Instagram and other networks ──
# where each video goes: youtube, tiktok, instagram, facebook, threads, x, linkedin, bluesky, pinterest
PUBLISH_TO=youtube
# Upload-Post (upload-post.com) relay: create a profile, connect TikTok/Instagram/... to it, then set its API key
# and the profile's name. TikTok needs a paid Upload-Post plan (TikTok's own API only lets audited apps go public).
# UPLOAD_POST_API_KEY=
# UPLOAD_POST_USER=
# blank = the account's default; PUBLIC_TO_EVERYONE|MUTUAL_FOLLOW_FRIENDS|FOLLOWER_OF_CREATOR|SELF_ONLY
# TIKTOK_PRIVACY=
# Instagram's own API instead of the relay (free; posts right away, can't schedule): a Meta app with Facebook
# Login for Business, a professional Instagram account and the instagram_content_publish permission
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_API_VERSION=v25.0

# ── Notifications ──
# Discord or Slack webhook, or any URL (receives JSON): rendered / uploaded / scheduled / queued / failed
# NOTIFY_WEBHOOK=

# ── Autopilot ──
BATCH_SIZE=1
# seconds between batches
BATCH_DELAY=60
# videos rendered in parallel
WORKERS=1
OUTPUT_DIR=output_videos
DATA_DIR=data

# ── Studio on a server ──
# require this password (any user name) for every Studio page and API call; set it whenever the Studio
# listens on more than 127.0.0.1 (studio --host 0.0.0.0)
# STUDIO_PASSWORD=
# a fixed token for the Studio's REST API (X-Studio-Token header), for n8n, cron or your own scripts.
# Blank = a new random token every start. See docs/api.md
# STUDIO_TOKEN=

# ── Advanced ──
# auto | pillow | ass  (ass = libass captions; auto uses it for Hindi, Tamil, Arabic, Thai, ...)
# CAPTION_RENDERER=auto
# Path to a specific ffmpeg binary
# FFMPEG_BINARY=
# Set to 1 to keep each video's work/ folder (voice, segments, caption frames) for debugging
# KEEP_WORK=
# PURFFLE_HOME is not read from this file. Set it in your MCP client's "env" block (or the shell) to the
# folder that holds this .env, credentials.json and your videos when an app starts `purffle-shorts mcp`.
