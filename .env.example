# ─────────────────────────────────────────────────────────────────────────────
# PurffleShorts 2 — copy to .env and fill in what you use. Everything is optional
# except ONE LLM key (or a local Ollama) and, for uploading, credentials.json.
# Run `python -m purffle_shorts doctor` to check your setup.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI script writer (pick any; LLM_PROVIDER=auto uses the first key found) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# XAI_API_KEY=
LLM_PROVIDER=auto            # auto|openai|anthropic|gemini|groq|openrouter|deepseek|mistral|together|xai|ollama|lmstudio|custom
# blank = provider default (see `providers` command); for Ollama, blank also falls back to a model you have pulled
LLM_MODEL=
# e.g. anthropic,gemini — tried in order if the main LLM fails
LLM_FALLBACKS=
# for LLM_PROVIDER=custom (any OpenAI-compatible endpoint)
# LLM_BASE_URL=
# LLM_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# low|medium|high|xhigh|max (Claude only)
# ANTHROPIC_EFFORT=

# ── Stock footage ──
PEXELS_API_KEY=
PIXABAY_API_KEY=
VISUAL_SOURCES=pexels,pixabay   # also: local (MEDIA_DIR), openai-images, pollinations (free AI images)
MEDIA_DIR=media                 # your own clips/photos; filenames are matched to scene keywords
IMAGE_MODEL=gpt-image-1         # for openai-images (or dall-e-3)
PREFER_4K=false

# ── Content ──
NICHES=mind-blowing science facts,unsolved mysteries,dark history,space and the universe,psychology tricks
TOPIC_SOURCES=niche             # niche,trending,wikipedia,reddit,file — weights allowed: niche:4,trending:1
TOPICS_FILE=topics.txt
TRENDS_GEO=US
SCRIPT_STYLE=auto               # auto|facts|story|listicle|myth|quiz|motivational|news|explainer
LANGUAGE=en                     # en, es, fr, de, hi, ta, te, pt, ja, ko, zh, ar, ... (voice picked automatically)
TARGET_SECONDS=40
CHANNEL_NAME=PurffleStudios
AUDIENCE=curious general audience

# ── Voice ──
TTS_ENGINE=edge                 # edge (free) | openai | elevenlabs | kokoro | coqui | system | silent
# blank = best voice for LANGUAGE; comma list = rotate. `voices` lists all
TTS_VOICE=
TTS_RATE=+8%
# openai: gpt-4o-mini-tts | tts-1-hd ; elevenlabs: eleven_multilingual_v2 ...
TTS_MODEL=
ELEVENLABS_API_KEY=
ALIGN=auto                      # word timing for voices without it: auto|faster-whisper|openai|none

# ── Look ──
RESOLUTION=1080x1920
FPS=30
CAPTION_STYLE=bold              # bold|boxed|neon|clean|karaoke|minimal
CAPTION_POSITION=center         # upper|center|lower
CAPTION_MAX_WORDS=3
CAPTION_UPPERCASE=true
# path to a .ttf to override the font
CAPTION_FONT=
COLOR_GRADE=vivid               # none|vivid|cinematic|warm|cool|bw
TRANSITION=random               # random|none|fade|slideup|smoothleft|circleopen|zoomin|...
KEN_BURNS=true
PROGRESS_BAR=true
HOOK_OVERLAY=true
# blank = CHANNEL_NAME, "none" to hide
WATERMARK=
END_CTA=Follow for more!
MUSIC_DIR=music                 # random track per video; falls back to MUSIC_FILE
MUSIC_FILE=back.mp3
MUSIC_VOLUME=0.14
MUSIC_DUCKING=true
VIDEO_ENCODER=libx264           # libx264|h264_videotoolbox (Mac)|h264_nvenc (NVIDIA)|auto
CRF=21
PRESET=veryfast

# ── YouTube ──
UPLOAD=true
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
YT_PRIVACY=public               # public|unlisted|private
# e.g. 09:00,14:00,19:00 -> uploads are scheduled into these slots
PUBLISH_TIMES=
# e.g. Asia/Kolkata (blank = this computer's timezone)
TIMEZONE=
YT_DAILY_LIMIT=6                # API quota allows ~6 uploads/day by default
PLAYLIST_ID=
MADE_FOR_KIDS=false
SYNTHETIC_MEDIA=true            # YouTube's altered/synthetic content disclosure
KEEP_VIDEOS=false               # keep the MP4 after a successful upload
CREDIT_FOOTAGE=true

# ── Autopilot ──
BATCH_SIZE=1
BATCH_DELAY=60                  # seconds between batches
WORKERS=1                       # videos rendered in parallel
OUTPUT_DIR=output_videos
DATA_DIR=data

# ── Advanced ──
# auto | pillow | ass  (ass = libass captions; auto uses it for Hindi, Tamil, Arabic, Thai, ...)
# CAPTION_RENDERER=auto
# Path to a specific ffmpeg binary
# FFMPEG_BINARY=
# Set to 1 to keep each video's work/ folder (voice, segments, caption frames) for debugging
# KEEP_WORK=
